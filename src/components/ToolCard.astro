---
import type { Tool } from '../data/site';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = tool.ready ? `${base}tools/${tool.slug}/` : undefined;
const Tag = tool.ready ? 'a' : 'div';
const searchText = [tool.title, tool.description, tool.category, ...tool.tags].join(' ').toLowerCase();
---

<Tag
  class:list={['card', { soon: !tool.ready }]}
  href={href}
  data-card
  data-category={tool.category}
  data-search={searchText}
>
  <div class="card-thumb" style={`background:${tool.color}`}>
    <span aria-hidden="true">{tool.emoji}</span>
    {!tool.ready && <span class="badge">準備中</span>}
  </div>
  <div class="card-body">
    <div class="card-cat">{tool.category}</div>
    <h3 class="card-title">{tool.title}</h3>
    <p class="card-desc">{tool.description}</p>
    <div class="card-price">{tool.free ? '無料で使える' : 'PRO限定'}</div>
  </div>
</Tag>
