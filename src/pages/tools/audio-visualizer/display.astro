---
import Base from '../../../layouts/Base.astro';
---

<Base title="オーディオビジュアライザー（配信表示）" bare>
  <canvas id="c" style="position:fixed;inset:0;width:100%;height:100%;display:block"></canvas>
  <div
    id="hint"
    hidden
    style="position:fixed;left:12px;bottom:12px;padding:6px 12px;border-radius:8px;background:rgba(0,0,0,.7);color:#fff;font:14px system-ui,sans-serif"
  >
  </div>
</Base>

<script>
  import { ObsClient } from '../../../scripts/obs';
  import {
    CUSTOM_EVENT_TYPE,
    LineRenderer,
    SETTINGS_KEY,
    demoLevel,
    fromHash,
    levelToNorm,
    loadConn,
    loadSettings,
    sanitize,
  } from '../../../scripts/line';

  const query = new URLSearchParams(location.search);
  const demo = query.get('demo') === '1';
  const hashData = fromHash(location.hash);

  // 優先順位: URLハッシュ > 保存済みの設定 > 初期値。操作パネルでの変更はあとから反映される
  let settings = sanitize({ ...loadSettings(), ...hashData.settings });
  const conn = hashData.conn ?? loadConn();

  const canvas = document.getElementById('c') as HTMLCanvasElement;
  const hint = document.getElementById('hint') as HTMLElement;
  const renderer = new LineRenderer(canvas);

  let levels: Record<string, number> = {};
  let state: 'none' | 'connecting' | 'connected' | 'error' = conn ? 'connecting' : 'none';
  let stateMessage = '';

  function updateHint() {
    let text = '';
    if (demo) text = '';
    else if (state === 'none') text = '操作パネルでOBSに接続してください';
    else if (state === 'connecting') text = 'OBSに接続中…';
    else if (state === 'error') text = stateMessage;
    else if (!settings.source) text = '操作パネルで音声ソースを選んでください';
    hint.textContent = text;
    hint.hidden = !text;
  }

  if (!demo && conn) {
    const client = new ObsClient(() => conn);
    client.onMeters = (m) => (levels = m);
    client.onCustom = (data) => {
      const d = data as { type?: string; settings?: unknown } | null;
      if (d?.type === CUSTOM_EVENT_TYPE) {
        settings = sanitize(d.settings as object);
        updateHint();
      }
    };
    client.onState = (s, msg) => {
      state = s === 'connected' ? 'connected' : s === 'connecting' ? 'connecting' : 'error';
      stateMessage = msg || 'OBSに接続できません';
      updateHint();
    };
    client.connect();
  }

  // 同じOBS内の操作パネルが保存した設定を、OBSを通さずに受け取る経路（使える場合のみ）
  window.addEventListener('storage', (e) => {
    if (e.key === SETTINGS_KEY) {
      settings = loadSettings();
      updateHint();
    }
  });

  updateHint();

  function frame(now: number) {
    const target = demo
      ? demoLevel(now / 1000)
      : levelToNorm(levels[settings.source] ?? 0, settings.threshold);
    renderer.frame(now, Math.min(1, target * settings.gain), settings);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
</script>
